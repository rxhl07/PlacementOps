PORT=5000
NODE_ENV=development

# PostgreSQL Connection (matches docker-compose)
DATABASE_URL="postgresql://placement_admin:placement_password_dev@localhost:5432/placementops_db?schema=public"

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=dev_jwt_access_secret_placementops_key_12345
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_placementops_key_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d